# Jigyasa AI - LLM Provider Configuration
# Set VITE_LLM_PROVIDER to "openai", "gemini", "anthropic", or "nvidia"
# Fill in the corresponding API key for your chosen provider.

VITE_LLM_PROVIDER="gemini"

# OpenAI Configuration
# Get key from: https://platform.openai.com/api-keys
VITE_OPENAI_KEY=""

# Google Gemini Configuration
# Get key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_KEY=""

# Anthropic Claude Configuration
# Get key from: https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_KEY=""

# NVIDIA NIM Configuration (OpenAI-compatible API at https://integrate.api.nvidia.com/v1)
# Get key from: https://build.nvidia.com/
VITE_NVIDIA_KEY=""
VITE_NVIDIA_MODEL="deepseek-ai/deepseek-r1"
